generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum RolUsuario {
  ADMINISTRADOR
  EVALUADOR
  ARTESANO
  VISITANTE
}

enum EstadoStand {
  DISPONIBLE
  OCUPADO
  MANTENIMIENTO
}

enum EstadoSolicitud {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

// ----------------------------------------------------
// MODELOS
// ----------------------------------------------------

model Usuario {
  id                   String                 @id @default(uuid()) @db.Uuid
  rol                  RolUsuario             @default(VISITANTE)
  nombre               String
  email                String                 @unique
  passwordHash         String

  artesano             Artesano?
  solicitudesEvaluadas SolicitudPostulacion[] @relation("EvaluadorSolicitud")

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Localidad {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  provincia String     @default("Catamarca")
  artesanos Artesano[]
  createdAt DateTime   @default(now())
}

model Artesano {
  id                     Int                    @id @default(autoincrement())
  usuarioId              String                 @unique @db.Uuid
  usuario                Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  localidadId            Int
  localidad              Localidad              @relation(fields: [localidadId], references: [id])

  nombre                 String
  apellido               String
  dni                    String                 @unique
  email                  String                 @unique
  telefono               String?
  nombreEmprendimiento   String
  rubro                  String
  descripcionTrayectoria String?                @db.Text
  activo                 Boolean                @default(true)

  productos              Producto[]
  stand                  Stand?                 // Relación 1:1 con Stand (un artesano tiene como máximo un stand)
  solicitudes            SolicitudPostulacion[]

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model Producto {
  id          Int      @id @default(autoincrement())
  artesanoId  Int
  artesano    Artesano @relation(fields: [artesanoId], references: [id], onDelete: Cascade)

  nombre      String
  descripcion String?  @db.Text
  precio      Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  activo      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([artesanoId])
}

model Pabellon {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  stands    Stand[]
  createdAt DateTime @default(now())
}

model Sector {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  stands    Stand[]
  createdAt DateTime @default(now())
}

model Stand {
  id          Int                    @id @default(autoincrement())
  codigo      String                 @unique
  numero      Int?
  estado      EstadoStand            @default(DISPONIBLE)

  pabellonId  Int
  pabellon    Pabellon               @relation(fields: [pabellonId], references: [id])

  sectorId    Int
  sector      Sector                 @relation(fields: [sectorId], references: [id])

  // Relación 1:1 con Artesano (@unique garantiza máximo 1 stand por artesano)
  artesanoId  Int?                   @unique
  artesano    Artesano?              @relation(fields: [artesanoId], references: [id], onDelete: SetNull)

  solicitudes SolicitudPostulacion[]

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([pabellonId])
  @@index([sectorId])
}

model SolicitudPostulacion {
  id                Int             @id @default(autoincrement())

  artesanoId        Int
  artesano          Artesano        @relation(fields: [artesanoId], references: [id], onDelete: Cascade)

  standId           Int?
  stand             Stand?          @relation(fields: [standId], references: [id], onDelete: SetNull)

  evaluadorId       String?         @db.Uuid
  evaluador         Usuario?        @relation("EvaluadorSolicitud", fields: [evaluadorId], references: [id], onDelete: SetNull)

  estado            EstadoSolicitud @default(PENDIENTE)
  observaciones     String?         @db.Text
  fechaPresentacion DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([artesanoId])
  @@index([standId])
  @@index([evaluadorId])
}
