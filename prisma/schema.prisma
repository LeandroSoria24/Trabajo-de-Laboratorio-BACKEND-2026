generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------
enum RolUsuario {
  ADMINISTRADOR
  ARTESANO
  VISITANTE
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  MODIFICACION_SOLICITADA
}

enum EstadoStand {
  DISPONIBLE
  OCUPADO
}

// -------------------------------------------------------------
// MODELOS
// -------------------------------------------------------------
model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  nombre       String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artesano     Artesano?
  solicitudes  SolicitudPostulacion[]
  consultas    RegistroConsulta[]
}

model Localidad {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  provincia String     @default("Catamarca")
  artesanos Artesano[]
  createdAt DateTime   @default(now())
}

model Artesano {
  id                     Int        @id @default(autoincrement())
  usuarioId              String?    @unique @db.Uuid
  usuario                Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  nombre                 String
  apellido               String
  dni                    String     @unique
  email                  String     @unique
  telefono               String?
  nombreEmprendimiento   String
  descripcionTrayectoria String?
  rubro                  String

  // Relación con la tabla Localidad
  localidadId            Int
  localidad              Localidad  @relation(fields: [localidadId], references: [id])

  // Soft delete en Artesano
  activo                 Boolean    @default(true)

  productos              Producto[]
  stand                  Stand?     // Relación 1:1 con Stand (un artesano tiene como máximo un stand asignado)

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @default(now()) @updatedAt
}

model Stand {
  id          Int         @id @default(autoincrement())
  codigo      String      @unique // Código identificatorio único del stand (ej: STD-101)
  numero      Int?
  pabellon    String      // Requerido para filtros GET /api/stands
  sector      String      // Requerido para filtros GET /api/stands
  estado      EstadoStand @default(DISPONIBLE)

  // artesanoId nullable para permitir que el stand esté DISPONIBLE sin artesano asignado
  artesanoId  Int?        @unique
  artesano    Artesano?   @relation(fields: [artesanoId], references: [id], onDelete: SetNull)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float
  stock       Int      @default(0)
  artesanoId  Int      // FK del lado N
  artesano    Artesano @relation(fields: [artesanoId], references: [id], onDelete: Cascade)

  // Soft delete en Producto
  eliminado   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model SolicitudPostulacion {
  id                   Int             @id @default(autoincrement())
  usuarioId            String?         @db.Uuid
  usuario              Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  datos_personales     String
  datos_emprendimiento String
  estado               EstadoSolicitud @default(PENDIENTE)
  observaciones        String?         // Observaciones del administrador (modificaciones solicitadas o rechazo)

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt
}

model RegistroConsulta {
  id               Int      @id @default(autoincrement())
  visitanteId      String?  @db.Uuid // Nullable para registrar consultas de visitantes anónimos
  usuario          Usuario? @relation(fields: [visitanteId], references: [id], onDelete: SetNull)

  termino_busqueda String
  fecha            DateTime @default(now())
}

